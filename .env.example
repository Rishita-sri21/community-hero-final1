# Copy this file to .env and fill in real values. Never commit .env.

# Required: MongoDB connection string (e.g. a free MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/community-hero

# Required: long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: Google Gemini API key. Without it, AI features use offline fallbacks.
GEMINI_API_KEY=

# Optional: where the frontend sends API requests. Leave empty to use the local server in
# development and the deployed backend in production builds.
VITE_API_URL=

# Optional: port for the server (hosting platforms usually set this). Defaults to 3000.
PORT=

# Optional, demo only: when no GEMINI_API_KEY is set, accept every resolution photo instead of
# refusing. Never enable this in production.
SIMULATE_AI_VERIFICATION=
